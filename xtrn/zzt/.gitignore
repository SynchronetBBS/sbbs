# Pascal reference source (kept locally for comparison, not shipped in this repo)
reconstruction-of-zzt-master/

# Ignore packed world subdirectories; keep root-level files in zzt_files/
zzt_files/*/

# Runtime-generated world high score files
*.HI
*.hi
data/

# The sysop's own configuration, seeded from zzt.example.ini by the installer.
# Kept untracked so a sysop's edits survive an upgrade and never dirty the tree.
zzt.ini
ZZT.INI
