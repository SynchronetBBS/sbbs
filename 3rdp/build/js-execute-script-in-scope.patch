+JS_ExecuteScriptInScope(JSContext *cx, JSObject *obj, JSObject *scriptObj, jsval *rval)
+{
+    JS_THREADSAFE_ASSERT(cx->compartment != cx->runtime->atomsCompartment);
+
+    CHECK_REQUEST(cx);
+    assertSameCompartment(cx, obj, scriptObj);
+
+    JSBool ok = Execute(cx, obj, scriptObj->getScript(), NULL, 0, Valueify(rval), true);
+    LAST_FRAME_CHECKS(cx, ok);
+    return ok;
+}
