@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

if(@XPDEV_CONFIG_NEEDS_SDL2@)
	find_dependency(SDL2 CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/xpdevTargets.cmake")

if(@XPDEV_CONFIG_NEEDS_SDL2@)
	# WITH_SDL_AUDIO is a public definition and gen_defs.h includes SDL.h.
	# Propagate SDL's usage requirements even where xpdev loads it dynamically.
	set_property(TARGET xpdev::static APPEND PROPERTY
		INTERFACE_LINK_LIBRARIES SDL2::SDL2)
	set_property(TARGET xpdev::shared APPEND PROPERTY
		INTERFACE_LINK_LIBRARIES SDL2::SDL2)
endif()

check_required_components(xpdev)
