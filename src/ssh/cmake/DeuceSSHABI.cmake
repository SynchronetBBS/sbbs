# Generate native export controls from the checked-in public ABI assignments.
include_guard(GLOBAL)

function(dssh_prepare_abi)
	set(binding_header "${CMAKE_CURRENT_SOURCE_DIR}/deucessh-abi.h")
	set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
		${DEUCESSH_PUBLIC_HEADERS})
	file(STRINGS "${binding_header}" assignments REGEX "^#define DSSH_ABI_SYMBOL_")
	set(names "")
	set(versions "")
	set(macho "")
	set(pe "EXPORTS\n")
	foreach(assignment IN LISTS assignments)
		if(NOT assignment MATCHES "^#define DSSH_ABI_SYMBOL_(dssh_[A-Za-z0-9_]+) +([A-Za-z0-9_]+)_v([0-9]+_[0-9]+(_[0-9]+)?)$")
			message(FATAL_ERROR "Malformed DeuceSSH ABI assignment: ${assignment}")
		endif()
		set(name "${CMAKE_MATCH_1}")
		set(external_name "${CMAKE_MATCH_2}")
		set(version "${CMAKE_MATCH_3}")
		if(NOT name STREQUAL external_name OR name IN_LIST names)
			message(FATAL_ERROR "Invalid or duplicate DeuceSSH ABI assignment: ${assignment}")
		endif()
		list(APPEND names "${name}")
		list(APPEND versions "${version}")
		string(APPEND symbols_${version} "\t\t${name};\n")
		string(APPEND macho "_${name}_v${version}\n")
		string(APPEND pe "\t${name}_v${version}\n")
	endforeach()
	if(NOT names)
		message(FATAL_ERROR "No DeuceSSH ABI assignments found")
	endif()

	# New declarations must receive an explicit assignment, and removed public
	# functions must not leave an export silently satisfied by something else.
	set(declared "")
	foreach(header IN LISTS DEUCESSH_PUBLIC_HEADERS)
		file(READ "${CMAKE_CURRENT_SOURCE_DIR}/${header}" contents)
		string(REGEX MATCHALL "(^|\n)DSSH_PUBLIC[^;]+;" declarations "${contents}")
		foreach(declaration IN LISTS declarations)
			if(declaration STREQUAL "")
				continue()
			endif()
			if(NOT declaration MATCHES "[ \t*](dssh_[A-Za-z0-9_]+)[ \t\r\n]*\\(")
				message(FATAL_ERROR "Unrecognized public declaration in ${header}: ${declaration}")
			endif()
			set(name "${CMAKE_MATCH_1}")
			if(NOT declaration MATCHES "DSSH_ABI\\(${name}\\)")
				message(FATAL_ERROR "Missing ABI annotation for ${name} in ${header}")
			endif()
			list(APPEND declared "${name}")
		endforeach()
	endforeach()
	list(SORT names)
	list(SORT declared)
	if(NOT names STREQUAL declared)
		message(FATAL_ERROR "DeuceSSH ABI assignments and public declarations differ")
	endif()
	file(STRINGS "${binding_header}" aliases REGEX "^#define dssh_")
	set(aliased "")
	foreach(alias IN LISTS aliases)
		if(NOT alias MATCHES "^#define (dssh_[A-Za-z0-9_]+) +DSSH_ABI_SYMBOL_([A-Za-z0-9_]+)$")
			message(FATAL_ERROR "Malformed DeuceSSH Windows ABI alias: ${alias}")
		endif()
		if(NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
			message(FATAL_ERROR "Mismatched DeuceSSH Windows ABI alias: ${alias}")
		endif()
		list(APPEND aliased "${CMAKE_MATCH_1}")
	endforeach()
	list(SORT aliased)
	if(NOT names STREQUAL aliased)
		message(FATAL_ERROR "DeuceSSH ABI assignments and Windows aliases differ")
	endif()

	list(REMOVE_DUPLICATES versions)
	list(SORT versions COMPARE NATURAL)
	set(elf "")
	set(predecessor "")
	foreach(version IN LISTS versions)
		string(REPLACE "_" "." dotted "${version}")
		set(node "DEUCESSH_${dotted}")
		string(APPEND elf "${node} {\n\tglobal:\n${symbols_${version}}")
		if(NOT predecessor)
			string(APPEND elf "\tlocal: *;\n")
		endif()
		string(APPEND elf "}${predecessor};\n")
		set(predecessor " ${node}")
	endforeach()
	# file(CONFIGURE) avoids relinks when generated contents are unchanged.
	foreach(format IN ITEMS map exports def)
		if(format STREQUAL map)
			set(content "${elf}")
		elseif(format STREQUAL exports)
			set(content "${macho}")
		else()
			set(content "${pe}")
		endif()
		set(path "${CMAKE_CURRENT_BINARY_DIR}/deucessh.${format}")
		file(CONFIGURE OUTPUT "${path}" CONTENT "@content@" @ONLY)
		set(DSSH_ABI_${format} "${path}" PARENT_SCOPE)
	endforeach()
endfunction()

function(dssh_apply_abi target)
	if(WIN32)
		target_sources(${target} PRIVATE "${DSSH_ABI_def}")
	elseif(APPLE)
		target_link_options(${target} PRIVATE
			"LINKER:-exported_symbols_list,${DSSH_ABI_exports}")
		set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${DSSH_ABI_exports}")
	elseif(UNIX)
		# A real export map cannot be used for a link probe: its definitions
		# aren't present in the probe executable, which LLD correctly rejects.
		set(probe "${CMAKE_CURRENT_BINARY_DIR}/deucessh-abi-probe.map")
		file(CONFIGURE OUTPUT "${probe}"
			CONTENT "DSSH_PROBE_1.0 { global: main; local: *; };\n")
		set(language C)
		if(DEUCESSH_CRYPTO_BACKEND STREQUAL Botan)
			set(language CXX)
		endif()
		dssh_check_option(${language} LINK "LINKER:--version-script=${probe}" supported)
		if(NOT supported)
			message(FATAL_ERROR "DeuceSSH shared builds require ELF symbol versioning support")
		endif()
		target_link_options(${target} PRIVATE "LINKER:--version-script=${DSSH_ABI_map}")
		set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${DSSH_ABI_map}")
	else()
		message(FATAL_ERROR "DeuceSSH has no shared-library ABI binding for this platform")
	endif()
endfunction()
