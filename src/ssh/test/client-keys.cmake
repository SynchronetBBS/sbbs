foreach(kind IN ITEMS static shared)
	if(NOT TARGET deucessh_${kind})
		continue()
	endif()
	set(target dssh_test_client_keys_${kind})
	add_executable(${target} test_client_keys.c mock_io.c)
	foreach(shim IN LISTS DSSH_THREADS_SHIM_SOURCES)
		target_sources(${target} PRIVATE "${PROJECT_SOURCE_DIR}/${shim}")
	endforeach()
	set_target_properties(${target} PROPERTIES C_STANDARD ${DEUCESSH_C_STANDARD}
		C_STANDARD_REQUIRED ON)
	target_compile_options(${target} PRIVATE ${DEUCESSH_COMPILE_OPTIONS})
	target_compile_definitions(${target} PRIVATE _DEFAULT_SOURCE)
	target_link_libraries(${target} PRIVATE deucessh_${kind} ${THREADS_LINK_LIB})
	if(DSSH_THREADS_SHIM_INCLUDE)
		target_include_directories(${target} BEFORE PRIVATE "${DSSH_THREADS_SHIM_INCLUDE}")
	endif()
	if(WIN32)
		target_link_libraries(${target} PRIVATE ws2_32)
	endif()
	foreach(algorithm IN ITEMS ssh-ed25519 rsa-sha2-256 rsa-sha2-512 test-client-key client-only)
		set(name dssh_client_keys_${kind}_${algorithm})
		dssh_add_output_test(${name} ${target} "client_keys algorithm=${algorithm}.*valid=1"
			"${algorithm}" "${CMAKE_CURRENT_BINARY_DIR}/client-keys-${kind}-${algorithm}")
		set_tests_properties(${name} PROPERTIES TIMEOUT 60)
	endforeach()
endforeach()
