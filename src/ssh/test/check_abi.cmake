cmake_minimum_required(VERSION 3.22)

function(inspect file output)
	execute_process(COMMAND "${INSPECTOR}" ${ARGN} "${file}"
		RESULT_VARIABLE status OUTPUT_VARIABLE listing ERROR_VARIABLE error)
	if(NOT status STREQUAL "0")
		message(FATAL_ERROR "ABI inspection failed for ${file}: ${status}\n${error}")
	endif()
	set(${output} "${listing}" PARENT_SCOPE)
endfunction()

file(STRINGS "${ASSIGNMENTS}" assignments REGEX "^#define DSSH_ABI_SYMBOL_")
set(expected "")
foreach(assignment IN LISTS assignments)
	if(NOT assignment MATCHES "^#define DSSH_ABI_SYMBOL_(dssh_[A-Za-z0-9_]+) +([A-Za-z0-9_]+)_v([0-9]+_[0-9]+(_[0-9]+)?)$")
		message(FATAL_ERROR "Malformed ABI assignment: ${assignment}")
	endif()
	set(name "${CMAKE_MATCH_1}")
	set(version "${CMAKE_MATCH_3}")
	if(FORMAT STREQUAL ELF)
		string(REPLACE "_" "." dotted "${version}")
		list(APPEND expected "${name}@@DEUCESSH_${dotted}")
	elseif(FORMAT STREQUAL MACHO)
		list(APPEND expected "_${name}_v${version}")
	else()
		list(APPEND expected "${name}_v${version}")
	endif()
	if(name STREQUAL dssh_hash_oneshot)
		if(FORMAT STREQUAL ELF)
			set(required "${name}@DEUCESSH_${dotted}")
		elseif(FORMAT STREQUAL MACHO)
			set(required "_${name}_v${version}")
		else()
			set(required "${name}_v${version}")
		endif()
	endif()
endforeach()

if(FORMAT STREQUAL ELF)
	inspect("${LIBRARY}" listing --dyn-syms --wide)
elseif(FORMAT STREQUAL MACHO)
	inspect("${LIBRARY}" listing -gU)
elseif(FORMAT STREQUAL PE)
	inspect("${LIBRARY}" listing /nologo /exports)
elseif(FORMAT STREQUAL PE_OBJDUMP)
	inspect("${LIBRARY}" listing -p)
else()
	message(FATAL_ERROR "Unknown ABI format: ${FORMAT}")
endif()
string(REPLACE "\n" ";" lines "${listing}")
set(actual "")
foreach(line IN LISTS lines)
	if(FORMAT STREQUAL ELF)
		if(line MATCHES "[ \t]+[0-9]+:[ \t]+[a-fA-F0-9]+[ \t]+[0-9]+[ \t]+[A-Z]+[ \t]+(GLOBAL|WEAK)[ \t]+DEFAULT[ \t]+([^ \t]+)[ \t]+([^ \t\r\n]+)")
			set(section "${CMAKE_MATCH_2}")
			set(symbol "${CMAKE_MATCH_3}")
			if(section STREQUAL UND)
				continue()
			endif()
			if(section STREQUAL ABS AND symbol MATCHES "^DEUCESSH_[0-9.]+$")
				continue()
			endif()
			list(APPEND actual "${symbol}")
		endif()
	elseif(FORMAT STREQUAL MACHO)
		if(line MATCHES "[ \t][A-Za-z][ \t]+([^ \t\r\n]+)$")
			list(APPEND actual "${CMAKE_MATCH_1}")
		endif()
	elseif(FORMAT STREQUAL PE)
		if(line MATCHES "^[ \t]+[0-9]+[ \t]+[A-Fa-f0-9]+[ \t]+[A-Fa-f0-9]+[ \t]+([^ \t\r\n]+)")
			list(APPEND actual "${CMAKE_MATCH_1}")
		endif()
	elseif(FORMAT STREQUAL PE_OBJDUMP)
		if(line MATCHES "^[ \t]*\\[[ \t]*[0-9]+\\][ \t]+(\\+base\\[[ \t]*[0-9]+\\][ \t]+[A-Fa-f0-9]+[ \t]+)?([A-Za-z_][A-Za-z0-9_]+)[ \t\r]*$")
			list(APPEND actual "${CMAKE_MATCH_2}")
		endif()
	endif()
endforeach()
list(SORT expected)
list(SORT actual)
if(NOT actual STREQUAL expected)
	set(missing "${expected}")
	set(unexpected "${actual}")
	list(REMOVE_ITEM missing ${actual})
	list(REMOVE_ITEM unexpected ${expected})
	message(FATAL_ERROR "Incorrect production ABI exports\nMissing: ${missing}\nUnexpected: ${unexpected}")
endif()

foreach(consumer IN ITEMS "${CONSUMER}" "${CONSUMER_DSO}")
	if(FORMAT STREQUAL ELF)
		inspect("${consumer}" imports --dyn-syms --wide --dynamic)
		if(NOT imports MATCHES "Shared library: \\[libdeucessh\\.so\\.1\\]")
			message(FATAL_ERROR "Consumer does not record its DeuceSSH dependency: ${consumer}")
		endif()
	elseif(FORMAT STREQUAL MACHO)
		inspect("${consumer}" imports -m -u)
		if(NOT imports MATCHES "from libdeucessh")
			message(FATAL_ERROR "Consumer lacks a two-level DeuceSSH binding: ${consumer}")
		endif()
	elseif(FORMAT STREQUAL PE)
		inspect("${consumer}" imports /nologo /imports)
	elseif(FORMAT STREQUAL PE_OBJDUMP)
		inspect("${consumer}" imports -p)
	endif()
	string(FIND "${imports}" "${required}" found)
	if(found EQUAL -1)
		message(FATAL_ERROR "Consumer lacks ${required}: ${consumer}\n${imports}")
	endif()
	if(FORMAT MATCHES "^PE")
		string(TOLOWER "${imports}" imports_lower)
		string(TOLOWER "${LIBRARY_NAME}" library_lower)
		string(FIND "${imports_lower}" "${library_lower}" dependency)
		if(dependency EQUAL -1)
			message(FATAL_ERROR "Consumer lacks its DeuceSSH DLL import: ${consumer}")
		endif()
	endif()
endforeach()
list(LENGTH expected count)
message(STATUS "Verified ${count} public exports and executable/DSO ABI imports (${FORMAT})")
