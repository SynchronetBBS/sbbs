if(DEUCESSH_CRYPTO_BACKEND STREQUAL "Botan")
	enable_language(CXX)
	add_executable(cxx_options "${CMAKE_CURRENT_LIST_DIR}/c_standard_fixture/options.cpp")
	set_target_properties(cxx_options PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED YES)
endif()

# Every state must perform fresh checks. Warm answers alone cannot establish
# isolation from parent inputs or prove that a linker invocation occurred.
get_cmake_property(results CACHE_VARIABLES)
foreach(result IN LISTS results)
	if(result MATCHES "^DSSH_OPTION_")
		unset(${result} CACHE)
	endif()
endforeach()

# Bad parent probe inputs must neither disable our options nor leak into the
# fixture's real targets. Exercise both cached and ordinary parent bindings.
set(inputs CMAKE_EXTRA_INCLUDE_FILES CMAKE_REQUIRED_FLAGS
	CMAKE_REQUIRED_DEFINITIONS CMAKE_REQUIRED_INCLUDES
	CMAKE_REQUIRED_LINK_OPTIONS CMAKE_REQUIRED_LINK_DIRECTORIES
	CMAKE_REQUIRED_LIBRARIES CMAKE_REQUIRED_QUIET)
foreach(input IN LISTS inputs)
	unset(${input} CACHE)
	if(OPTION_CASE STREQUAL cached)
		set(${input} "dssh-parent-${input}" CACHE STRING "Parent check input" FORCE)
	elseif(OPTION_CASE STREQUAL normal)
		set(${input} "dssh-parent-${input}")
	endif()
endforeach()
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(HAVE_WCONVERSION FALSE CACHE INTERNAL "Unrelated parent's old answer" FORCE)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/DeuceSSHOptions.cmake")
dssh_configure_options()
foreach(language IN ITEMS C CXX)
	if(language STREQUAL CXX AND NOT DEUCESSH_CRYPTO_BACKEND STREQUAL "Botan")
		continue()
	endif()
	dssh_check_option(${language} COMPILE -fdssh-option-not-supported accepted)
	if(accepted)
		message(FATAL_ERROR "Accepted an invalid ${language} compiler option")
	endif()
	dssh_check_option(${language} LINK -Wl,--dssh-option-not-supported accepted)
	if(accepted)
		message(FATAL_ERROR "Linker option was not checked by a real ${language} link")
	endif()
endforeach()
# Toolchain flags remain part of the actual check and its cache identity.
# A failed check with bad global flags must not disable the restored driver.
foreach(language IN ITEMS C CXX)
	if(language STREQUAL CXX AND NOT DEUCESSH_CRYPTO_BACKEND STREQUAL "Botan")
		continue()
	endif()
	if(CMAKE_${language}_COMPILER_ID MATCHES "GNU|Clang")
		set(saved_flags "${CMAKE_${language}_FLAGS}")
		set(CMAKE_${language}_FLAGS "${saved_flags} -fdssh-global-option-not-supported")
		dssh_check_option(${language} COMPILE -Wconversion accepted)
		if(accepted)
			message(FATAL_ERROR "Global compiler flags did not affect the check")
		endif()
		set(CMAKE_${language}_FLAGS "${saved_flags}")
		dssh_check_option(${language} COMPILE -Wconversion accepted)
		if(NOT accepted)
			message(FATAL_ERROR "Another toolchain context poisoned the option result")
		endif()
	endif()
endforeach()
foreach(input IN LISTS inputs)
	if(OPTION_CASE STREQUAL clean)
		if(DEFINED ${input})
			message(FATAL_ERROR "Check introduced parent input ${input}")
		endif()
	elseif(NOT "${${input}}" STREQUAL "dssh-parent-${input}")
		message(FATAL_ERROR "Check changed parent input ${input}")
	endif()
endforeach()
if(NOT CMAKE_TRY_COMPILE_TARGET_TYPE STREQUAL STATIC_LIBRARY OR HAVE_WCONVERSION)
	message(FATAL_ERROR "Check changed the parent's try-compile type or old result")
endif()
if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang"
    AND NOT "$<$<COMPILE_LANGUAGE:C>:-Wconversion>" IN_LIST DEUCESSH_COMPILE_OPTIONS)
	message(FATAL_ERROR "Unrelated parent answer disabled conversion warnings")
endif()
target_compile_options(c_standard PRIVATE ${DEUCESSH_COMPILE_OPTIONS})
target_link_options(c_standard PRIVATE ${DEUCESSH_LINK_OPTIONS})
if(TARGET cxx_options)
	target_compile_options(cxx_options PRIVATE ${DEUCESSH_COMPILE_OPTIONS})
	target_link_options(cxx_options PRIVATE ${DEUCESSH_LINK_OPTIONS})
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/options.txt"
	"${DEUCESSH_COMPILE_OPTIONS}\n${DEUCESSH_SHARED_COMPILE_OPTIONS}\n${DEUCESSH_LINK_OPTIONS}\n")
