# Native controls for actual exit/output policy, including a matching nonzero
# child that PASS_REGULAR_EXPRESSION would incorrectly accept.
if(DEFINED OUTPUT_POLICY_CHILD)
	if(NOT "${OUTPUT_POLICY_PAYLOAD}" STREQUAL "argument with spaces")
		message(FATAL_ERROR "Child argument was not preserved")
	endif()
	if(OUTPUT_POLICY_CHILD STREQUAL "missing")
		message("different-marker")
	else()
		message("required-marker")
	endif()
	if(OUTPUT_POLICY_CHILD STREQUAL "nonzero")
		message(FATAL_ERROR "Expected child failure after matching output")
	elseif(OUTPUT_POLICY_CHILD MATCHES "Sanitizer|runtime error:")
		message("${OUTPUT_POLICY_CHILD}")
	endif()
	return()
endif()

set(checks 0)
foreach(kind IN ITEMS success nonzero missing AddressSanitizer LeakSanitizer ThreadSanitizer
	UndefinedBehaviorSanitizer "runtime error:")
	set(command "${CMAKE_COMMAND};-DOUTPUT_POLICY_CHILD=${kind};-DOUTPUT_POLICY_PAYLOAD=argument with spaces;-P;${CMAKE_CURRENT_LIST_FILE}")
	execute_process(COMMAND "${CMAKE_COMMAND}" "-DTEST_COMMAND=${command}"
		"-DTEST_REQUIRED_OUTPUT=required-marker" -P "${CMAKE_CURRENT_LIST_DIR}/check_output.cmake"
		RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
	if(kind STREQUAL "success")
		if(NOT "${result}" STREQUAL "0")
			message(FATAL_ERROR "Successful child rejected: ${output}${errors}")
		endif()
	else()
		if("${result}" STREQUAL "0")
			message(FATAL_ERROR "Unsuccessful ${kind} child accepted: ${output}${errors}")
		endif()
		if(kind STREQUAL "nonzero")
			set(reason "Test process did not succeed")
		elseif(kind STREQUAL "missing")
			set(reason "Test process did not emit its required output")
		else()
			set(reason "Test process emitted a sanitizer diagnostic")
		endif()
		if(NOT "${output}${errors}" MATCHES "${reason}")
			message(FATAL_ERROR "Wrong ${kind} rejection: ${output}${errors}")
		endif()
	endif()
	math(EXPR checks "${checks} + 1")
endforeach()
message("Output policy controls passed: ${checks}")
