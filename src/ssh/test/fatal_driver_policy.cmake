# Real process controls for every driver family and its strict CTest wrapper.
# Diagnostic words are safe literal child input, never an induced memory error.
cmake_minimum_required(VERSION 3.20)
foreach(input IN ITEMS FATAL_DRIVER FATAL_CHILD)
	if(NOT DEFINED ${input} OR NOT EXISTS "${${input}}")
		message(FATAL_ERROR "A real ${input} executable is required")
	endif()
endforeach()
set(raw_runs 0)
set(strict_runs 0)
function(check_family family scenario)
	if(family STREQUAL "join")
		set(arguments stop)
	elseif(family STREQUAL "shim")
		set(arguments mutex-destroy)
	elseif(family STREQUAL "unlock")
		set(arguments --unlock-fatal primitive held)
	elseif(family STREQUAL "wake")
		set(arguments --wake-fatal lock-tx before)
	elseif(family STREQUAL "channel")
		set(arguments --channel-fatal open retained)
	else()
		message(FATAL_ERROR "Unknown family ${family}")
	endif()
	set(child "${FATAL_CHILD}")
	if(scenario STREQUAL "exec-missing")
		string(APPEND child ".missing-control")
		if(EXISTS "${child}")
			message(FATAL_ERROR "The missing-child control unexpectedly exists")
		endif()
	endif()
	set(command "${CMAKE_COMMAND}" -E env "DSSH_FATAL_POLICY_CASE=${scenario}"
		"${FATAL_DRIVER}" "${child}" ${arguments})
	execute_process(COMMAND ${command}
		RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
	math(EXPR raw_runs "${raw_runs} + 1")
	set(text "${output}${errors}")
	if(scenario STREQUAL "missing" OR scenario STREQUAL "exec-missing")
		set(expected 8)
	elseif(scenario STREQUAL "fake-exit" OR scenario STREQUAL "wrong-signal")
		set(expected 6)
	else()
		set(expected 0)
	endif()
	if(NOT "${result}" STREQUAL "${expected}")
		message(FATAL_ERROR "${family}/${scenario}: raw result ${result}, expected ${expected}: ${text}")
	endif()
	if(NOT scenario STREQUAL "exec-missing" AND NOT text MATCHES "diagnostic_tail=1")
		message(FATAL_ERROR "${family}/${scenario}: full child diagnostics were not forwarded")
	endif()
	if(scenario STREQUAL "fake-exit" OR scenario STREQUAL "wrong-signal")
		if(NOT text MATCHES "fatal child wait status ([0-9]+); expected SIGABRT")
			message(FATAL_ERROR "${family}/${scenario}: native wait status missing")
		endif()
		set(raw_wait_status "${CMAKE_MATCH_1}")
	endif()
	if(expected EQUAL 0 AND NOT text MATCHES "fatal_child=1")
		message(FATAL_ERROR "${family}/${scenario}: driver success marker missing")
	endif()
	if(scenario STREQUAL "fake-exit" AND NOT text MATCHES "fatal_child=1")
		message(FATAL_ERROR "The matching-output/unsuccessful-driver control did not execute")
	endif()
	if(scenario MATCHES "Sanitizer|runtime error:" AND NOT text MATCHES "${scenario} synthetic-control")
		message(FATAL_ERROR "The literal diagnostic control did not execute")
	endif()
	execute_process(COMMAND "${CMAKE_COMMAND}" "-DTEST_COMMAND=${command}"
		-DTEST_REQUIRED_OUTPUT=fatal_child=1
		-P "${CMAKE_CURRENT_LIST_DIR}/check_output.cmake"
		RESULT_VARIABLE strict_result OUTPUT_VARIABLE strict_output ERROR_VARIABLE strict_errors)
	math(EXPR strict_runs "${strict_runs} + 1")
	if(scenario STREQUAL "clean")
		if(NOT "${strict_result}" STREQUAL "0" OR NOT "${strict_output}${strict_errors}" MATCHES "diagnostic_tail=1")
			message(FATAL_ERROR "${family}: clean strict control failed: ${strict_output}${strict_errors}")
		endif()
	else()
		if("${strict_result}" STREQUAL "0")
			message(FATAL_ERROR "${family}/${scenario}: strict control accepted an invalid result")
		endif()
		if(expected EQUAL 0)
			set(reason "Test process emitted a sanitizer diagnostic")
		else()
			set(reason "Test process did not succeed")
		endif()
		if(NOT "${strict_output}${strict_errors}" MATCHES "${reason}")
			message(FATAL_ERROR "${family}/${scenario}: wrong strict rejection: ${strict_output}${strict_errors}")
		endif()
		set(strict_text "${strict_output}${strict_errors}")
		if(NOT scenario STREQUAL "exec-missing" AND NOT strict_text MATCHES "diagnostic_tail=1")
			message(FATAL_ERROR "${family}/${scenario}: strict rejection lacked the actual child tail")
		endif()
		if(expected EQUAL 0)
			if(NOT strict_text MATCHES "fatal_child=1" OR NOT strict_text MATCHES "${scenario} synthetic-control")
				message(FATAL_ERROR "${family}/${scenario}: wrong diagnostic source")
			endif()
		elseif(NOT strict_text MATCHES "Test process did not succeed: ${expected}([^0-9]|$)")
			message(FATAL_ERROR "${family}/${scenario}: wrong driver failure result")
		endif()
		if(DEFINED raw_wait_status AND NOT strict_text MATCHES "fatal child wait status ${raw_wait_status}; expected SIGABRT")
			message(FATAL_ERROR "${family}/${scenario}: strict/native wait outcomes differ")
		endif()
	endif()
	set(raw_runs "${raw_runs}" PARENT_SCOPE)
	set(strict_runs "${strict_runs}" PARENT_SCOPE)
endfunction()

foreach(family IN ITEMS join shim unlock wake channel)
	foreach(scenario IN ITEMS clean AddressSanitizer LeakSanitizer ThreadSanitizer UndefinedBehaviorSanitizer
		"runtime error:" fake-exit wrong-signal missing exec-missing)
		check_family("${family}" "${scenario}")
	endforeach()
endforeach()
foreach(kind IN ITEMS argc0 argc1 argc3 unknown_join unknown_trace)
	if(kind STREQUAL "argc0")
		set(arguments "")
	elseif(kind STREQUAL "argc1")
		set(arguments "${FATAL_CHILD}")
	elseif(kind STREQUAL "argc3")
		set(arguments "${FATAL_CHILD}" --wake-fatal lock-tx)
	elseif(kind STREQUAL "unknown_join")
		set(arguments "${FATAL_CHILD}" unsupported)
	else()
		set(arguments "${FATAL_CHILD}" --unsupported lock-tx before)
	endif()
	execute_process(COMMAND "${FATAL_DRIVER}" ${arguments}
		RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
	math(EXPR raw_runs "${raw_runs} + 1")
	if(NOT "${result}" STREQUAL "2" OR NOT "${output}${errors}" STREQUAL "")
		message(FATAL_ERROR "Driver argument validation ${kind} failed: ${result}: ${output}${errors}")
	endif()
endforeach()
if(NOT raw_runs EQUAL 55 OR NOT strict_runs EQUAL 50)
	message(FATAL_ERROR "Incomplete fatal-driver control matrix")
endif()
message("fatal_policy families=5 cases=50 raw=55 strict=50 valid=1")
