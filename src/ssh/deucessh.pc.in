prefix=@DSSH_PC_PREFIX@
exec_prefix=${prefix}
libdir=@DSSH_PC_LIBDIR@
includedir=@DSSH_PC_INCLUDEDIR@

Name: deucessh
Description: SSH protocol library (RFCs 4250-4254)
Version: @PROJECT_VERSION@
@DSSH_PC_REQUIRES_FIELD@: @DSSH_PC_REQUIRES_PRIVATE@
Libs: @DSSH_PC_MAIN_LIBS@
@DSSH_PC_LIBS_PRIVATE_LINE@
Cflags: -I${includedir}
