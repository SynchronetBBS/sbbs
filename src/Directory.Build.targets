<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-imported by MSBuild after every vcxproj's body, for all projects under
  src/ that don't have a nearer Directory.Build.targets (e.g. doors/syncscumm/*
  shadow this with their own).

  On the GitLab runner only (CI=true in the environment), for Release|Win32:
    - Disable PDB generation (DebugInformationFormat=None, GenerateDebugInformation=false),
      which removes mspdbsrv.exe from the toolchain.
    - Disable whole-program optimization / link-time code generation
      (WholeProgramOptimization=false drops /GL; LinkTimeCodeGeneration=Default
      drops /LTCG:incremental), which removes the LTCG backend (c2.dll).

  Both subsystems produced sporadic internal-compiler-error failures on the
  runner. Local Release builds are unaffected and keep their .pdb files, so a
  Release build deployed from a developer machine can be symbolized.

  Everywhere, for Release|Win32: link with /OPT:REF and /OPT:ICF. Most projects
  leave these unset, and /DEBUG switches the linker's default to /OPT:NOREF,
  which keeps unreferenced code in the binaries.

  This file lives at src/ rather than src/sbbs3/ because the shared library
  projects (notably xpdev_mt.vcxproj, in src/xpdev/) are built by multiple
  solutions (sbbs3.sln, sexpots.sln, vdmodem.sln, SyncTERM.sln), and a
  src/sbbs3/ file only covers projects physically under src/sbbs3/.
-->
<Project>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <Link>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>
  <PropertyGroup Condition="'$(CI)'=='true' And '$(Configuration)|$(Platform)'=='Release|Win32'">
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(CI)'=='true' And '$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <DebugInformationFormat>None</DebugInformationFormat>
      <WholeProgramOptimization>false</WholeProgramOptimization>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>false</GenerateDebugInformation>
      <LinkTimeCodeGeneration>Default</LinkTimeCodeGeneration>
    </Link>
  </ItemDefinitionGroup>
</Project>
